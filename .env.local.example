# ============================================================================
# ENERGIALY - CLIENT Environment Variables
# ============================================================================
# Copiar este archivo como .env.local y completar con los valores reales

# ── Backend API URL ─────────────────────────────────────────────────────────
# IMPORTANTE: Las variables NEXT_PUBLIC_* son visibles en el navegador
# NUNCA poner secrets o información sensible aquí

# Para desarrollo local:
NEXT_PUBLIC_BASE_URL=http://localhost:3001

# Para Vercel DEV:
# NEXT_PUBLIC_BASE_URL=https://api-dev.energialy.vercel.app

# Para Vercel Producción:
# NEXT_PUBLIC_BASE_URL=https://api.energialy.vercel.app

# ── UploadThing (si se usa) ─────────────────────────────────────────────────
# UPLOADTHING_SECRET=
# UPLOADTHING_APP_ID=
